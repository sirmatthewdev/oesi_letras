---
interface Props {
    titulo: string;
    bajada?: string;
    /** Centrado como en la portada, o alineado a la izquierda en interiores. */
    centrado?: boolean;
    /** Texto pequeño en versalitas doradas sobre el título. */
    kicker?: string;
    claro?: boolean;
    /**
     * Va al <h2>. Lo necesitan las secciones que se anuncian con
     * `aria-labelledby`: sin el, el atributo apunta a un id que no existe y el
     * lector de pantalla anuncia la seccion sin nombre.
     */
    id?: string;
}

const { titulo, bajada, centrado = false, kicker, claro = false, id } = Astro.props;

// Titulo en dos tonos: la ultima palabra en el azul de acento, como los de la
// referencia («Testimonios *que inspiran*»). Se parte en la ultima palabra y no
// en un marcado del panel para que funcione con cualquier titulo sin pedirle
// nada a quien lo escribe; un titulo de una sola palabra va entero en azul.
const corte = titulo.trimEnd().lastIndexOf(' ');
const [inicio, final] = corte > 0 ? [titulo.slice(0, corte + 1), titulo.slice(corte + 1)] : [titulo, ''];
---

<header class={centrado ? 'text-center' : ''}>
    {
        kicker && (
            <p
                class:list={[
                    'inline-flex items-center gap-2 rounded-full px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.16em]',
                    claro ? 'bg-white/10 text-unmsm-dorado-light' : 'bg-unmsm-azul/[0.06] text-unmsm-azul',
                ]}
            >
                <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-unmsm-dorado"></span>
                {kicker}
            </p>
        )
    }

    <h2
        id={id}
        class:list={[
            'font-serif text-3xl font-extrabold sm:text-4xl',
            kicker ? 'mt-4' : '',
            claro ? 'text-white' : 'text-unmsm-azul',
        ]}
    >
        {inicio}{final && <span class={claro ? 'text-unmsm-dorado-light' : 'text-unmsm-acento'}>{final}</span>}
    </h2>

    {/* La regla bajo el título es el gesto que identifica al sitio. Deja de ser
        un dorado plano: recorre el degradado de marca —azul a dorado— y se
        ensancha al entrar la sección, que es lo que la hace parecer parte del
        movimiento y no un adorno pegado. */}
    <div
        class:list={[
            'regla-marca marca-degradado mt-3 h-1 rounded-full',
            centrado ? 'mx-auto' : '',
        ]}
        data-revelar
        aria-hidden="true"
    >
    </div>

    {
        bajada && (
            <p
                class:list={[
                    'mt-4 max-w-2xl text-lg',
                    centrado ? 'mx-auto' : '',
                    claro ? 'text-slate-200' : 'text-slate-600',
                ]}
            >
                {bajada}
            </p>
        )
    }
</header>

<style>
    .regla-marca {
        width: 4rem;
    }

    /* Al pasar por la cabecera de la seccion la regla se estira: un gesto
       corto, sobre un elemento decorativo, que no mueve el texto de sitio. */
    header:hover .regla-marca {
        width: 6rem;
    }

    .regla-marca {
        transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @media (prefers-reduced-motion: reduce) {
        .regla-marca {
            transition: none;
        }

        header:hover .regla-marca {
            width: 4rem;
        }
    }
</style>
