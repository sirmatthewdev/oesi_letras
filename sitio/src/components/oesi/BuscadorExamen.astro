---
/**
 * «Encuentra tu examen», bajo el acordeón de idiomas: la barra de búsqueda de
 * la referencia (Idiomas PUCP), con lo que hay en la OESI. Se elige idioma y,
 * si se quiere, modalidad, y responde con las próximas fechas de ese examen
 * (del cronograma cargado en el panel) y los pasos siguientes.
 *
 * Sin JavaScript el formulario lleva a /cronograma, que tiene las mismas
 * fechas. Con él responde en el sitio, sin recargar. No inventa nada: si no
 * hay fecha publicada lo dice, y si el idioma no se ofrece en la modalidad
 * elegida, también.
 */
import Icono from '../Icono.astro';
import type { Oesi } from '../../lib/api';
import type { FechaExamen } from '../../lib/fechas';
import { faMagnifyingGlass } from '@fortawesome/free-solid-svg-icons';

interface Props {
    idiomas: Oesi['idiomas'];
    fechas: FechaExamen[];
    whatsapp: string | null;
}

const { idiomas, fechas, whatsapp } = Astro.props;
const datos = {
    idiomas: idiomas.map((i) => ({ nombre: i.nombre, publico: i.publico, modalidades: i.modalidades })),
    fechas,
    whatsapp,
};
---

{
    idiomas.length > 0 && (
        <section aria-labelledby="t-buscador" class="mx-auto mb-12 max-w-5xl px-4 lg:mb-16" data-buscador>
            <form
                action="/cronograma"
                method="get"
                class="grid items-end gap-3 rounded-3xl bg-white p-4 shadow-lg shadow-unmsm-azul/10 ring-1 ring-slate-200 sm:grid-cols-[auto_1fr_1fr_auto] sm:rounded-full sm:py-3 sm:pl-6 sm:pr-3"
            >
                {/* Un párrafo y no un h2: va antes del h1 de la oficina, y como
                    título abría el esquema de la portada. Sigue nombrando la
                    sección (`aria-labelledby`). */}
                <p id="t-buscador" class="font-serif text-base font-bold leading-tight text-unmsm-azul sm:pr-2">
                    Encuentra <br class="hidden sm:block" />tu examen
                </p>
                <label class="block min-w-0">
                    <span class="block px-1 text-[0.7rem] font-semibold uppercase tracking-wider text-slate-500">Idioma</span>
                    <select name="idioma" required class="mt-0.5 w-full rounded-xl border-0 bg-slate-50 px-3 py-2.5 text-sm font-medium text-slate-800 ring-1 ring-slate-200 focus:ring-2 focus:ring-unmsm-acento">
                        <option value="">Elige el idioma</option>
                        {idiomas.map((i) => (
                            <option value={i.nombre}>{i.nombre}</option>
                        ))}
                    </select>
                </label>
                <label class="block min-w-0">
                    <span class="block px-1 text-[0.7rem] font-semibold uppercase tracking-wider text-slate-500">Modalidad</span>
                    <select name="modalidad" class="mt-0.5 w-full rounded-xl border-0 bg-slate-50 px-3 py-2.5 text-sm font-medium text-slate-800 ring-1 ring-slate-200 focus:ring-2 focus:ring-unmsm-acento">
                        <option value="">Cualquiera</option>
                        <option value="presencial">Presencial</option>
                        <option value="virtual">Virtual</option>
                    </select>
                </label>
                <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-full bg-unmsm-azul px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-unmsm-azul-dark">
                    <Icono icono={faMagnifyingGlass} clase="h-4 w-4" />
                    Buscar
                </button>
            </form>

            <div data-resultado aria-live="polite" class="mt-4"></div>
            <script type="application/json" data-buscador-datos set:html={JSON.stringify(datos)} />
        </section>
    )
}

<script>
    import { corta, larga, vigentes, type FechaExamen } from '../../lib/fechas';
    import { normalizar } from '../../lib/oesi';

    type Datos = {
        idiomas: { nombre: string; publico: string | null; modalidades: ('presencial' | 'virtual')[] }[];
        fechas: FechaExamen[];
        whatsapp: string | null;
    };

    // La flecha del sitio (la de components/Flecha.astro), para el HTML que se
    // arma aquí: los resultados se pintan en el navegador.
    const FLECHA =
        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 flex-none" aria-hidden="true"><circle cx="12" cy="12" r="10.25"/><path d="M9 15 15 9M10 9h5v5"/></svg>';

    // Todo lo que se pinta sale de datos de la oficina: se escapa, nunca HTML.
    const esc = (t: string) => t.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

    function iniciarBuscador() {
        const raiz = document.querySelector<HTMLElement>('[data-buscador]');
        if (!raiz || raiz.dataset.listo) return;
        raiz.dataset.listo = '1';
        const form = raiz.querySelector('form')!;
        const salida = raiz.querySelector<HTMLElement>('[data-resultado]')!;
        const datos: Datos = JSON.parse(raiz.querySelector('[data-buscador-datos]')!.textContent!);

        form.addEventListener('submit', (e) => {
            e.preventDefault();
            const f = new FormData(form);
            const nombre = String(f.get('idioma') || '');
            const modalidad = String(f.get('modalidad') || '') as '' | 'presencial' | 'virtual';
            const idioma = datos.idiomas.find((i) => i.nombre === nombre);
            if (!idioma) return;

            const etiqueta = modalidad === 'presencial' ? 'presencial' : modalidad === 'virtual' ? 'virtual' : '';
            // El idioma no se ofrece en esa modalidad: se dice, con la que sí hay.
            const fueraDeModalidad = modalidad && idioma.modalidades.length > 0 && !idioma.modalidades.includes(modalidad);
            const proximas = vigentes(datos.fechas).filter(
                (x) => normalizar(x.idioma) === normalizar(idioma.nombre) && (!modalidad || x.modalidad === modalidad)
            );

            let html = '';
            if (fueraDeModalidad) {
                html += `<p class="rounded-2xl bg-amber-50 px-4 py-3 text-sm text-amber-950 ring-1 ring-amber-200">El examen de <strong>${esc(idioma.nombre)}</strong> no se ofrece en modalidad ${etiqueta}: es ${esc(idioma.modalidades.join(' y '))}.</p>`;
            } else if (proximas.length) {
                html += `<ul class="grid gap-3 sm:grid-cols-2">${proximas
                    .map(
                        (x) => `<li data-vence="${esc(x.inicio)}" class="flex items-center gap-4 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200">
                            <span class="rounded-xl bg-unmsm-azul px-3 py-2 text-center text-sm font-bold leading-tight text-white">${esc(corta(x.inicio).split(' · ')[0])}</span>
                            <span class="min-w-0 text-sm text-slate-700">
                                <span class="block font-semibold text-unmsm-azul">${esc(idioma.nombre)} · ${x.modalidad === 'presencial' ? 'Presencial' : 'Virtual'}</span>
                                ${esc(corta(x.inicio).split(' · ')[1])}${x.publico ? ` · ${esc(x.publico)}` : ''}
                                <span class="block text-xs text-slate-500">Inscripción hasta el ${esc(larga(x.cierre_inscripcion))}</span>
                            </span>
                        </li>`
                    )
                    .join('')}</ul>`;
            } else {
                html += `<p class="rounded-2xl bg-slate-50 px-4 py-3 text-sm text-slate-700 ring-1 ring-slate-200">Aún no hay fecha publicada para <strong>${esc(idioma.nombre)}</strong>${etiqueta ? ` ${etiqueta}` : ''}. La oficina publica el cronograma cada mes${datos.whatsapp ? `; si tienes prisa, <a class="font-semibold text-unmsm-azul underline" href="${esc(datos.whatsapp)}" target="_blank" rel="noopener noreferrer">escríbenos por WhatsApp</a>` : ''}.</p>`;
            }
            html += `<p class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold text-unmsm-azul">
                <a class="inline-flex items-center gap-1.5 hover:underline" href="/cronograma">Ver todo el cronograma ${FLECHA}</a>
                <a class="inline-flex items-center gap-1.5 hover:underline" href="/inscripcion#paso-pago">Costos y pago ${FLECHA}</a>
            </p>`;
            salida.innerHTML = html;
        });
    }

    iniciarBuscador();
    document.addEventListener('astro:page-load', iniciarBuscador);
</script>
