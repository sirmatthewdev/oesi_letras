---
/**
 * Portada de la OESI: el hero de la portada del CERSEU, con lo de la oficina.
 *
 * Fondo hondo plano, la fotografía de la Facultad a sangre en la sección entera
 * —fundida hacia el texto con un degradado del color del fondo, no tapada con
 * un velo—, la deriva lenta y el seguimiento del ratón, y las cifras dentro del
 * hero, en la banda translúcida por la que asoma la foto. Son las mismas piezas
 * y los mismos valores que allí, para que los dos sitios se lean como hermanos.
 *
 * La fotografía es un fichero del propio sitio (`src/assets`), no una URL de
 * Laravel: es la imagen de la Facultad y no cambia con el contenido, y así el
 * build la optimiza sin depender de nada más.
 */
import { Image } from 'astro:assets';
import Boton from '../Boton.astro';
import Icono from '../Icono.astro';
import RedesSociales from '../RedesSociales.astro';
import CopiarDato from './CopiarDato.astro';
import campus from '../../assets/campus-aerea.webp';
import type { Oesi } from '../../lib/api';
import { faWhatsapp } from '@fortawesome/free-brands-svg-icons';
import {
    faFileCircleCheck,
    faLanguage,
    faFaceSmile,
    faLandmark,
    faChartSimple,
    faUserPlus,
} from '@fortawesome/free-solid-svg-icons';

interface Props {
    oesi: Oesi;
}

const { oesi } = Astro.props;
const { contacto } = oesi;
const wa = contacto.whatsapp;
const cifras = oesi.estadisticas.cifras;

// Un icono por cifra, en el orden en que las carga la oficina. Si se añade una
// quinta, cae al genérico: no hay por qué adivinar qué mide.
const ICONOS_CIFRA = [faFileCircleCheck, faLanguage, faFaceSmile, faLandmark];
const iconoCifra = (i: number) => ICONOS_CIFRA[i] ?? faChartSimple;

// Impar en dos columnas deja la última sola y pegada a la izquierda: se centra
// a lo ancho, como en la banda del CERSEU.
const ultimaSola = cifras.length % 2 === 1;
---

<section class="hero-portada relative isolate overflow-hidden text-white">
    <div
        aria-hidden="true"
        class="absolute inset-0 -z-20 opacity-[0.05]"
        style="background-image: radial-gradient(circle at 1px 1px, #fff 1.5px, transparent 0); background-size: 30px 30px;"
    >
    </div>
    <div aria-hidden="true" class="hero-luz absolute -z-20"></div>

    <div class="hero-marco relative">
        <div class="relative z-10 mx-auto w-full max-w-7xl px-4 lg:px-8">
            <div class="hero-texto max-w-xl pb-12 pt-32 lg:max-w-[33rem] lg:pb-0 lg:pt-0 xl:max-w-[38rem]">
                {
                    oesi.institucion && (
                        <p class="hero-entra hero-entra-1 text-[0.7rem] font-semibold uppercase leading-relaxed tracking-[0.22em] text-unmsm-dorado-light sm:text-xs">
                            {oesi.institucion}
                        </p>
                    )
                }
                <div aria-hidden="true" class="hero-entra hero-entra-1 marca-regla mt-4 h-px w-16 opacity-80"></div>

                <h1 class="hero-entra hero-entra-2 mt-7 font-serif text-[2.1rem] font-bold leading-[1.05] sm:text-5xl lg:text-[3.2rem] xl:text-[3.6rem]">
                    {oesi.nombre}
                </h1>

                {
                    oesi.bajada && (
                        <p class="hero-entra hero-entra-3 mt-6 max-w-lg leading-relaxed text-slate-300 lg:text-lg">
                            {oesi.bajada}
                        </p>
                    )
                }

                <div class="hero-entra hero-entra-4 mt-10 flex flex-wrap items-center gap-3">
                    {
                        wa && (
                            <Boton href={wa.enlace} icono={faWhatsapp} tamano="grande" nuevaPestana clase="max-sm:w-full">
                                Contáctanos
                            </Boton>
                        )
                    }
                    <Boton href="#como-inscribirte" variante="contorno-claro" icono={faUserPlus} tamano="grande" clase="max-sm:w-full">
                        Cómo inscribirte
                    </Boton>
                </div>

                {/* El contacto, rotulado y con su botón de copiar. En la landing
                    anterior este bloque copiaba un dato que no existía y anidaba
                    mal sus etiquetas: el teléfono no llegaba a pintarse. */}
                <dl class="hero-entra hero-entra-5 mt-10 grid gap-x-10 gap-y-4 text-sm text-slate-200 sm:grid-cols-[auto_1fr]">
                    {
                        contacto.email && (
                            <div class="min-w-0">
                                <dt class="text-[11px] font-semibold uppercase tracking-wider text-unmsm-azul-soft">Correo</dt>
                                <dd class="mt-1 flex items-center gap-1">
                                    <a href={`mailto:${contacto.email}`} class="whitespace-nowrap hover:text-white hover:underline">
                                        {contacto.email}
                                    </a>
                                    <CopiarDato valor={contacto.email} que="el correo" />
                                </dd>
                            </div>
                        )
                    }
                    {
                        wa && (
                            <div>
                                <dt class="text-[11px] font-semibold uppercase tracking-wider text-unmsm-azul-soft">WhatsApp</dt>
                                <dd class="mt-1 flex items-center gap-1">
                                    <a href={wa.enlace} target="_blank" rel="noopener noreferrer" class="hover:text-white hover:underline">
                                        {wa.visible}
                                    </a>
                                    <CopiarDato valor={wa.visible} que="el número de WhatsApp" />
                                </dd>
                            </div>
                        )
                    }
                    {
                        contacto.horario && (
                            <div class="sm:col-span-2">
                                <dt class="text-[11px] font-semibold uppercase tracking-wider text-unmsm-azul-soft">Horario de atención</dt>
                                <dd class="mt-1">{contacto.horario}</dd>
                            </div>
                        )
                    }
                </dl>
                <p id="oesi-aviso-copia" class="sr-only" aria-live="polite"></p>

                <div class="hero-entra hero-entra-5 mt-8">
                    <RedesSociales redes={oesi.redes} forma="circulo" />
                </div>
            </div>
        </div>
    </div>

    {/* Las cifras, dentro del hero y sobre la foto: la banda del CERSEU. */}
    {
        cifras.length > 0 && (
            <section class="banda-sobre-foto relative isolate text-white" aria-label="La OESI en cifras">
                <div
                    aria-hidden="true"
                    class="absolute inset-0 -z-10 opacity-[0.05]"
                    style="background-image: radial-gradient(circle at 1px 1px, #fff 1.5px, transparent 0); background-size: 30px 30px;"
                />
                <div class="marca-regla h-px w-full opacity-70" aria-hidden="true" />

                {/* Solo la vista previa llega aquí con cifras sin verificar: el
                    sitio publicado no las recibe. */}
                {!oesi.estadisticas.verificadas && (
                    <p class="mx-auto max-w-6xl px-6 pt-4 text-center text-[0.7rem] font-semibold uppercase tracking-wider text-amber-300" role="note">
                        Cifras pendientes de verificación: no se publican hasta marcarlas en el panel
                    </p>
                )}

                <dl data-revelar-grupo class="mx-auto grid max-w-6xl grid-cols-2 gap-y-6 px-6 py-10 lg:grid-cols-4 lg:divide-x lg:divide-white/10">
                    {cifras.map((c, i) => (
                        <div class:list={['flex flex-col-reverse px-4 text-center', ultimaSola && i === cifras.length - 1 ? 'max-lg:col-span-2' : '']}>
                            <dt class="mt-1 text-[0.7rem] font-medium uppercase tracking-wider text-slate-300">{c.etiqueta}</dt>
                            <dd class="mt-2 font-serif text-3xl font-bold" data-contador={`${c.prefijo}${c.valor}${c.sufijo}`}>
                                {c.prefijo}{c.valor}{c.sufijo}
                            </dd>
                            <span data-revelar aria-hidden="true" class="mx-auto flex h-7 items-center justify-center text-unmsm-dorado">
                                <Icono icono={iconoCifra(i)} clase="h-6 w-6" />
                            </span>
                        </div>
                    ))}
                </dl>
            </section>
        )
    }

    <div class="hero-foto" data-sigue-raton>
        <div class="hero-foto-raton">
            <Image
                src={campus}
                alt="Vista de la Ciudad Universitaria de San Marcos, donde está la Facultad de Letras"
                widths={[960, 1600, 2400]}
                sizes="100vw"
                loading="eager"
                fetchpriority="high"
                class="hero-foto-img"
            />
        </div>
        <span aria-hidden="true" class="hero-foto-fundido"></span>
    </div>
</section>

<style>
    /* Mismos valores que el hero de la portada del CERSEU: los comentarios del
       porqué de cada uno están allí, en `pages/index.astro`. */
    .hero-portada {
        background-color: var(--color-fondo-hondo);
    }

    .hero-luz {
        top: -18rem;
        right: -12rem;
        height: 40rem;
        width: 40rem;
        border-radius: 9999px;
        background: radial-gradient(
            circle,
            color-mix(in oklab, var(--color-unmsm-dorado) 22%, transparent) 0%,
            transparent 68%
        );
        filter: blur(36px);
        pointer-events: none;
    }

    .banda-sobre-foto {
        background-color: color-mix(in oklab, var(--color-fondo-hondo) 82%, transparent);
    }

    .hero-foto {
        position: absolute;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        pointer-events: none;
    }

    .hero-foto-raton {
        position: absolute;
        inset: -5%;
        transform: translate3d(calc(var(--raton-h, 0) * 16px), calc(var(--raton-v, 0) * 11px), 0);
        will-change: transform;
    }

    .hero-foto-img {
        height: 100%;
        width: 100%;
        object-fit: cover;
        filter: saturate(0.82) contrast(1.06) brightness(0.92);
    }

    .hero-foto-fundido {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
            linear-gradient(to bottom, color-mix(in oklab, var(--color-fondo-hondo) 88%, transparent) 0%, transparent 26%),
            linear-gradient(
                to bottom,
                color-mix(in oklab, var(--color-fondo-hondo) 94%, transparent) 0%,
                color-mix(in oklab, var(--color-fondo-hondo) 88%, transparent) 38%,
                color-mix(in oklab, var(--color-fondo-hondo) 26%, transparent) 56%,
                color-mix(in oklab, var(--color-fondo-hondo) 26%, transparent) 100%
            );
    }

    @media (min-width: 1024px) {
        .hero-portada {
            display: flex;
            flex-direction: column;
            min-height: 100svh;
            padding-top: var(--alto-cabecera);
        }

        .hero-marco {
            flex: 1;
            display: flex;
            align-items: center;
            padding-block: 2.5rem;
        }

        .hero-foto-fundido {
            background:
                linear-gradient(
                    to bottom,
                    color-mix(in oklab, var(--color-fondo-hondo) 90%, transparent) 0%,
                    color-mix(in oklab, var(--color-fondo-hondo) 72%, transparent) 14%,
                    transparent 34%
                ),
                linear-gradient(
                    to right,
                    var(--color-fondo-hondo) 0%,
                    color-mix(in oklab, var(--color-fondo-hondo) 92%, transparent) 42%,
                    color-mix(in oklab, var(--color-fondo-hondo) 45%, transparent) 64%,
                    transparent 86%
                ),
                linear-gradient(to top, color-mix(in oklab, var(--color-fondo-hondo) 55%, transparent) 0%, transparent 16%);
        }
    }

    @media (prefers-reduced-motion: no-preference) {
        .hero-entra {
            animation: hero-entra 0.7s cubic-bezier(0.22, 0.61, 0.36, 1) both;
        }
        .hero-entra-1 {
            animation-delay: 0.05s;
        }
        .hero-entra-2 {
            animation-delay: 0.14s;
        }
        .hero-entra-3 {
            animation-delay: 0.23s;
        }
        .hero-entra-4 {
            animation-delay: 0.3s;
        }
        .hero-entra-5 {
            animation-delay: 0.38s;
        }
        .hero-foto {
            animation: hero-foto-entra 1.1s ease-out both;
            animation-delay: 0.1s;
        }
        .hero-foto-img {
            animation: hero-deriva 34s ease-in-out infinite alternate;
        }
    }

    @keyframes hero-deriva {
        from {
            transform: scale(1.04) translate3d(0, 0, 0);
        }
        to {
            transform: scale(1.09) translate3d(-1.6%, -1.2%, 0);
        }
    }

    @keyframes hero-entra {
        from {
            opacity: 0;
            transform: translateY(18px);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }

    /* La foto no arranca en invisible: si la animación no corre, la portada no
       se queda en negro. */
    @keyframes hero-foto-entra {
        from {
            opacity: 0.55;
            transform: scale(1.035);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }
</style>

<script>
    import { seguirAlRaton } from '../../lib/sigue-raton';

    seguirAlRaton();
    document.addEventListener('astro:page-load', seguirAlRaton);
</script>
