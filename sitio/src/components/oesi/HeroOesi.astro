---
/**
 * Portada de la OESI.
 *
 * Rediseño con Idiomas PUCP como referencia: fondo claro con manchas de color,
 * el titulo grande en dos tonos a la izquierda y, a la derecha, la fotografia
 * de la Facultad en una tarjeta redondeada con dos avisos encima —la
 * publicacion vigente del cronograma y las modalidades—. Las cifras salen del
 * hero y van debajo, en columnas con su filete de color, como las de la
 * referencia.
 *
 * Lo que dice es lo mismo que antes, y sale de la API: nombre, institucion,
 * contacto con su boton de copiar, redes y cifras. Lo unico nuevo es que, sin
 * bajada en el panel, el hero toma la primera frase del objetivo del examen:
 * un hero con solo el nombre de la oficina no dice a que se dedica.
 *
 * Rendimiento: la foto se sirve optimizada y a la medida de la tarjeta (no a
 * sangre en toda la pantalla), y sin la deriva infinita ni el seguimiento del
 * raton del hero anterior.
 */
import { Image } from 'astro:assets';
import Boton from '../Boton.astro';
import Icono from '../Icono.astro';
import RedesSociales from '../RedesSociales.astro';
import CopiarDato from './CopiarDato.astro';
import HeroIdiomas from './HeroIdiomas.astro';
import fachada from '../../assets/campus-fachada.webp';
import type { Oesi } from '../../lib/api';
import { faWhatsapp } from '@fortawesome/free-brands-svg-icons';
import {
    faArrowRight,
    faBuildingColumns,
    faCalendarDays,
    faClock,
    faEnvelope,
    faLaptop,
    faUserPlus,
} from '@fortawesome/free-solid-svg-icons';

interface Props {
    oesi: Oesi;
}

const { oesi } = Astro.props;
const { contacto } = oesi;
const wa = contacto.whatsapp;
const cifras = oesi.estadisticas.cifras;

// Sin bajada en el panel, la primera frase del objetivo del examen.
const bajada = oesi.bajada ?? oesi.examen.objetivo?.match(/^[^.]+\./)?.[0] ?? null;

// El nombre en dos tonos: lo que va despues del ultimo « de », en el azul de
// acento («Oficina de Examen de *Suficiencia en Idiomas*»). Solo si ese corte
// deja algo a cada lado; si no, el nombre va entero en azul.
const corte = oesi.nombre.lastIndexOf(' de ');
const [nombreInicio, nombreAcento] =
    corte > 0 && corte + 4 < oesi.nombre.length
        ? [oesi.nombre.slice(0, corte + 4), oesi.nombre.slice(corte + 4)]
        : [oesi.nombre, ''];

// Las modalidades que la oficina tiene cargadas, para el aviso de la foto.
const hayPresencial = oesi.modalidades.items.some((m) => m.modalidad === 'presencial');
const hayVirtual = oesi.modalidades.items.some((m) => m.modalidad !== 'presencial');
const publicacion = oesi.cronograma.imagen?.alt || null;

// Un color por cifra, como los filetes de la referencia, pero dentro de la
// paleta de la casa. Si hay mas cifras que colores, se repiten.
const COLORES_CIFRA = ['var(--color-unmsm-dorado)', 'var(--color-unmsm-acento)', 'var(--color-unmsm-azul)', 'var(--color-unmsm-azul-soft)'];
---

<section class="hero-portada fondo-manchas relative overflow-hidden bg-white">
    {/* Primero, los idiomas: el acordeón de la referencia. Sin idiomas
        cargados en el panel no se pinta, y la portada abre con la oficina. */}
    {
        oesi.idiomas.length > 0 && (
            <div class="hero-entra hero-entra-1 mx-auto mb-10 max-w-7xl lg:mb-12 lg:px-8">
                <HeroIdiomas idiomas={oesi.idiomas} />
            </div>
        )
    }

    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 pb-14 lg:grid-cols-[1.05fr_1fr] lg:gap-16 lg:px-8 lg:pb-20">
        <div class="max-w-xl">
            {
                oesi.institucion && (
                    <p class="hero-entra hero-entra-1 inline-flex items-center gap-2 rounded-full bg-white px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-unmsm-azul shadow-sm ring-1 ring-slate-200">
                        <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-unmsm-dorado" />
                        {oesi.institucion}
                    </p>
                )
            }

            <h1 class="hero-entra hero-entra-2 mt-6 font-serif text-[2.4rem] font-extrabold leading-[1.05] text-unmsm-azul sm:text-5xl lg:text-[3.6rem]">
                {nombreInicio}
                {nombreAcento && <span class="text-unmsm-acento">{nombreAcento}</span>}
            </h1>

            {bajada && <p class="hero-entra hero-entra-3 mt-6 max-w-lg text-lg leading-relaxed text-slate-600">{bajada}</p>}

            <div class="hero-entra hero-entra-4 mt-8 flex flex-wrap items-center gap-3">
                <Boton href="#como-inscribirte" variante="azul" icono={faUserPlus} tamano="grande" clase="max-sm:w-full">
                    Cómo inscribirte
                </Boton>
                {
                    wa && (
                        <Boton href={wa.enlace} variante="contorno" icono={faWhatsapp} tamano="grande" nuevaPestana clase="max-sm:w-full">
                            Contáctanos
                        </Boton>
                    )
                }
            </div>

            {/* El contacto, en fichas: cada dato con su rotulo y su boton de
                copiar, como antes. */}
            <dl class="hero-entra hero-entra-5 mt-10 flex flex-wrap gap-3 text-sm">
                {
                    contacto.email && (
                        <div class="ficha-contacto max-w-full">
                            <Icono icono={faEnvelope} clase="h-4 w-4 flex-none text-unmsm-dorado" />
                            <div class="min-w-0">
                                <dt class="ficha-rotulo">Correo</dt>
                                <dd class="flex items-center gap-1">
                                    <a href={`mailto:${contacto.email}`} class="truncate font-medium text-slate-800 hover:text-unmsm-azul hover:underline">
                                        {contacto.email}
                                    </a>
                                    <CopiarDato valor={contacto.email} que="el correo" clase="text-slate-500 hover:bg-slate-100" />
                                </dd>
                            </div>
                        </div>
                    )
                }
                {
                    wa && (
                        <div class="ficha-contacto">
                            <Icono icono={faWhatsapp} clase="h-4 w-4 flex-none text-unmsm-dorado" />
                            <div>
                                <dt class="ficha-rotulo">WhatsApp</dt>
                                <dd class="flex items-center gap-1">
                                    <a href={wa.enlace} target="_blank" rel="noopener noreferrer" class="font-medium text-slate-800 hover:text-unmsm-azul hover:underline">
                                        {wa.visible}
                                    </a>
                                    <CopiarDato valor={wa.visible} que="el número de WhatsApp" clase="text-slate-500 hover:bg-slate-100" />
                                </dd>
                            </div>
                        </div>
                    )
                }
                {
                    contacto.horario && (
                        <div class="ficha-contacto">
                            <Icono icono={faClock} clase="h-4 w-4 flex-none text-unmsm-dorado" />
                            <div>
                                <dt class="ficha-rotulo">Horario de atención</dt>
                                <dd class="font-medium text-slate-800">{contacto.horario}</dd>
                            </div>
                        </div>
                    )
                }
            </dl>
            <p id="oesi-aviso-copia" class="sr-only" aria-live="polite"></p>

            <div class="hero-entra hero-entra-5 mt-6 text-unmsm-azul [&_a]:border-slate-200 [&_a]:bg-white [&_a]:shadow-sm">
                <RedesSociales redes={oesi.redes} forma="circulo" />
            </div>
        </div>

        {/* La fotografia, en tarjeta, con los avisos encima. */}
        <div class="hero-entra hero-entra-3 relative mx-auto w-full max-w-xl lg:max-w-none">
            <div aria-hidden="true" class="marca-degradado absolute -inset-3 -z-10 rotate-2 rounded-[2.5rem] opacity-15"></div>
            <Image
                src={fachada}
                alt="Fachada de la Facultad de Letras y Ciencias Humanas de San Marcos, con el busto de César Vallejo"
                widths={[480, 720, 960, 1280]}
                sizes="(min-width: 1024px) 40vw, 100vw"
                loading="eager"
                fetchpriority="high"
                class="aspect-[4/3.4] w-full rounded-[2rem] object-cover shadow-xl shadow-unmsm-azul/15"
            />

            {
                (hayPresencial || hayVirtual) && (
                    <a
                        href="/modalidades"
                        class="aviso-foto absolute right-4 top-4 flex items-center gap-2 px-3.5 py-2 text-xs font-semibold text-unmsm-azul sm:right-6 sm:top-6"
                    >
                        {hayPresencial && <Icono icono={faBuildingColumns} clase="h-3.5 w-3.5 text-unmsm-dorado" />}
                        {hayPresencial && 'Presencial'}
                        {hayPresencial && hayVirtual && <span aria-hidden="true" class="text-slate-300">·</span>}
                        {hayVirtual && <Icono icono={faLaptop} clase="h-3.5 w-3.5 text-unmsm-dorado" />}
                        {hayVirtual && 'Virtual'}
                    </a>
                )
            }

            <a
                href="/cronograma"
                class="aviso-foto group absolute -bottom-6 left-4 right-4 flex items-center gap-4 p-4 sm:left-6 sm:right-auto sm:max-w-md"
            >
                <span aria-hidden="true" class="marca-degradado flex h-11 w-11 flex-none items-center justify-center rounded-xl text-white">
                    <Icono icono={faCalendarDays} clase="h-5 w-5" />
                </span>
                <span class="min-w-0">
                    <span class="block text-[0.7rem] font-semibold uppercase tracking-wider text-slate-500">
                        {publicacion ? 'Publicación vigente' : 'Antes de empezar'}
                    </span>
                    <span class="line-clamp-2 block font-semibold leading-snug text-unmsm-azul">{publicacion ?? 'Elige tu fecha en el cronograma'}</span>
                </span>
                <Icono icono={faArrowRight} clase="h-4 w-4 flex-none text-unmsm-azul transition group-hover:translate-x-0.5" />
            </a>
        </div>
    </div>

    {/* Las cifras, en columnas con su filete de color y su marca cuadrada. */}
    {
        cifras.length > 0 && (
            <section class="relative mx-auto max-w-7xl px-4 pb-16 pt-6 lg:px-8" aria-label="La OESI en cifras">
                {/* Solo la vista previa llega aquí con cifras sin verificar: el
                    sitio publicado no las recibe. */}
                {!oesi.estadisticas.verificadas && (
                    <p class="pb-4 text-center text-[0.7rem] font-semibold uppercase tracking-wider text-amber-600" role="note">
                        Cifras pendientes de verificación: no se publican hasta marcarlas en el panel
                    </p>
                )}

                <dl data-revelar-grupo class="grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-4">
                    {cifras.map((c, i) => (
                        <div class="cifra flex flex-col-reverse pl-6" style={`--cifra-color: ${COLORES_CIFRA[i % COLORES_CIFRA.length]}`}>
                            <dt class="mt-1 max-w-[14rem] text-sm leading-snug text-slate-600">{c.etiqueta}</dt>
                            <dd class="font-serif text-4xl font-extrabold text-unmsm-azul sm:text-5xl" data-contador={`${c.prefijo}${c.valor}${c.sufijo}`}>
                                {c.prefijo}{c.valor}{c.sufijo}
                            </dd>
                            <span data-revelar aria-hidden="true" class="cifra-marca" />
                        </div>
                    ))}
                </dl>
            </section>
        )
    }
</section>

<style>
    /* El hero se mete debajo de la cabecera flotante, como antes. */
    .hero-portada {
        padding-top: calc(var(--alto-cabecera) + 1.5rem);
    }

    .ficha-contacto {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        min-width: 0;
        border-radius: 1rem;
        background-color: rgb(255 255 255 / 0.8);
        padding: 0.7rem 1rem;
        box-shadow: inset 0 0 0 1px rgb(15 43 72 / 0.08);
    }

    .ficha-rotulo {
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgb(100 116 139);
    }

    /* Los avisos sobre la foto: blancos, opacos, con sombra. Opacos y no de
       cristal: encima de una fotografia el desenfoque cuesta en cada pintado y
       el texto se lee peor. */
    .aviso-foto {
        border-radius: 1.25rem;
        background-color: #fff;
        box-shadow: 0 18px 40px -18px rgb(15 43 72 / 0.45);
        transition:
            transform 250ms ease,
            box-shadow 250ms ease;
    }

    .aviso-foto:hover {
        transform: translateY(-2px);
        box-shadow: 0 22px 44px -18px rgb(15 43 72 / 0.55);
    }

    /* El filete de cada cifra: una linea discontinua vertical con una marca
       cuadrada a la altura del numero. */
    .cifra {
        position: relative;
    }

    .cifra::before {
        content: '';
        position: absolute;
        left: 0.4rem;
        top: -0.5rem;
        bottom: -0.5rem;
        border-left: 2px dashed var(--cifra-color);
    }

    .cifra-marca {
        position: absolute;
        left: 0;
        top: 0.9rem;
        height: 0.9rem;
        width: 0.9rem;
        border-radius: 0.2rem;
        background-color: var(--cifra-color);
    }

    @media (prefers-reduced-motion: no-preference) {
        .hero-entra {
            animation: hero-entra 0.7s cubic-bezier(0.22, 0.61, 0.36, 1) both;
        }
        .hero-entra-1 {
            animation-delay: 0.05s;
        }
        .hero-entra-2 {
            animation-delay: 0.12s;
        }
        .hero-entra-3 {
            animation-delay: 0.2s;
        }
        .hero-entra-4 {
            animation-delay: 0.28s;
        }
        .hero-entra-5 {
            animation-delay: 0.36s;
        }
    }

    @keyframes hero-entra {
        from {
            opacity: 0;
            transform: translateY(18px);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }
</style>

