---
/**
 * /preguntas: las dudas, por tema, con buscador.
 *
 * Parte de `PaginaOesi`, que pone el marco (cabecera, índice, «Continúa» y
 * las anclas). Los estilos de estas páginas están allí, en su <style>.
 */
import type { Oesi } from '../../../lib/api';
import Icono from '../../Icono.astro';
import FondoSeccion from '../../FondoSeccion.astro';
import Negritas from '../Negritas.astro';
import ContactoDudas from '../ContactoDudas.astro';
import { agruparPreguntas, normalizar, sinMarcas } from '../../../lib/oesi';
import { faCalendarDays, faListCheck, faMagnifyingGlass, faAward, faCircleQuestion, faPlus, faReceipt } from '@fortawesome/free-solid-svg-icons';
import { icono } from '../../../lib/oesi-vista';

interface Props {
    oesi: Oesi;
}

const { oesi } = Astro.props;
const { contacto, inscripcion } = oesi;
const wa = contacto.whatsapp;

// Las preguntas frecuentes por tema, en el orden que fija el modelo.
const gruposFaq = agruparPreguntas(oesi.faqs.temas, oesi.faqs.items);
const ICONOS_TEMA: Record<string, typeof faCircleQuestion> = {
    fechas: faCalendarDays,
    requisitos: faListCheck,
    inscripcion: faReceipt,
    resultados: faAward,
};
const iconoTema = (clave: string) => ICONOS_TEMA[clave] ?? faCircleQuestion;
---

{/* ══ Preguntas frecuentes ══ */}
{/*
 * Doce preguntas en una sola columna eran una pared de títulos iguales.
 * Se reparten por tema —el tema lo elige la oficina en el panel— y se
 * acompañan de lo que hace falta para encontrar la propia: un buscador,
 * el índice de temas y, si no está, a quién escribir.
 *
 * <details> y no un acordeón con script: abre con teclado y con lector de
 * pantalla sin nada que mantener, y el buscador del navegador encuentra
 * el texto de las respuestas cerradas.
 */}
<div id="preguntas" class="panel-oesi">
    <section class="relative isolate overflow-clip bg-fondo-suave py-12">
        <FondoSeccion />
        <div class="mx-auto max-w-6xl px-6">
            <div class="grid items-start gap-8 lg:grid-cols-12" data-faq>
                <aside class="space-y-5 lg:sticky lg:top-28 lg:col-span-4" aria-label="Buscar y recorrer las preguntas">
                    {/* El buscador aparece con JavaScript: sin él no
                        filtraría nada, y las preguntas se ven todas. */}
                    <div hidden data-faq-buscador class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                        <label for="faq-buscar" class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">
                            Busca tu pregunta
                        </label>
                        <div class="relative mt-3">
                            <Icono icono={faMagnifyingGlass} clase="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" />
                            <input
                                id="faq-buscar"
                                type="search"
                                autocomplete="off"
                                placeholder="voucher, reprogramar, devolución…"
                                class="w-full rounded-xl border border-slate-200 bg-slate-50 py-2.5 pl-10 pr-3 text-sm text-slate-800 placeholder:text-slate-400 focus:border-unmsm-azul focus:bg-white focus:outline-none focus:ring-2 focus:ring-unmsm-azul/20"
                            />
                        </div>
                        <p class="mt-2 text-xs text-slate-500" data-faq-cuenta aria-live="polite"></p>
                    </div>

                    <nav aria-label="Temas" class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Temas</p>
                        <ul class="mt-3 space-y-1">
                            {gruposFaq.map((g) => (
                                <li data-faq-indice={g.clave}>
                                    <a
                                        href={`#faq-${g.clave}`}
                                        class="group flex items-center gap-3 rounded-lg px-2 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 hover:text-unmsm-azul"
                                    >
                                        <span aria-hidden="true" class="flex h-8 w-8 flex-none items-center justify-center rounded-lg bg-slate-100 text-unmsm-dorado transition group-hover:bg-unmsm-azul group-hover:text-white">
                                            <Icono icono={iconoTema(g.clave)} clase="h-3.5 w-3.5" />
                                        </span>
                                        <span class="flex-1">{g.etiqueta}</span>
                                        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-500" data-faq-cuenta-tema>
                                            {g.items.length}
                                        </span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </nav>

                    <ContactoDudas whatsapp={wa} email={contacto.email} horario={contacto.horario} clase="hidden lg:block" />
                </aside>

                <div class="space-y-12 lg:col-span-8">
                    {gruposFaq.map((g) => (
                        <section id={`faq-${g.clave}`} aria-labelledby={`t-faq-${g.clave}`} class="scroll-mt-28" data-faq-grupo>
                            <h2 id={`t-faq-${g.clave}`} class="flex items-center gap-3 font-serif text-xl font-bold text-unmsm-azul">
                                <span aria-hidden="true" class="flex h-9 w-9 items-center justify-center rounded-xl bg-white text-unmsm-dorado shadow-sm">
                                    <Icono icono={iconoTema(g.clave)} clase="h-4 w-4" />
                                </span>
                                {g.etiqueta}
                            </h2>

                            <div class="mt-5 space-y-3">
                                {g.items.map((f) => (
                                    <details
                                        name="preguntas-oesi"
                                        class="pregunta-oesi group relative overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition open:border-unmsm-dorado/50 open:shadow-md"
                                        data-buscar={normalizar([sinMarcas(f.pregunta), sinMarcas(f.respuesta), ...f.lista].join(' '))}
                                    >
                                        <span aria-hidden="true" class="absolute inset-y-0 left-0 w-1 bg-unmsm-dorado opacity-0 transition group-open:opacity-100"></span>
                                        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 font-serif text-base font-bold leading-snug text-unmsm-azul">
                                            <span>{f.pregunta}</span>
                                            <span aria-hidden="true" class="flex h-8 w-8 flex-none items-center justify-center rounded-full bg-slate-100 text-unmsm-dorado transition duration-300 group-open:rotate-45 group-open:bg-unmsm-azul group-open:text-white">
                                                <Icono icono={faPlus} clase="h-3 w-3" />
                                            </span>
                                        </summary>
                                        <div class="border-t border-slate-100 px-6 pb-6 pt-4 leading-relaxed text-slate-600">
                                            <p><Negritas texto={f.respuesta} /></p>
                                            {f.lista.length > 0 && (
                                                <ul class="mt-3 space-y-1.5">
                                                    {f.lista.map((l) => <li class="vineta-oesi">{l}</li>)}
                                                </ul>
                                            )}
                                        </div>
                                    </details>
                                ))}
                            </div>
                        </section>
                    ))}

                    <div hidden data-faq-vacio class="rounded-2xl border border-dashed border-slate-300 bg-white/60 px-6 py-12 text-center">
                        <p class="font-serif text-lg font-bold text-slate-700">Ninguna pregunta coincide con tu búsqueda</p>
                        <p class="mx-auto mt-2 max-w-md text-sm text-slate-500">
                            Prueba con otra palabra, o escríbenos: te respondemos en el horario de atención.
                        </p>
                    </div>

                    <ContactoDudas whatsapp={wa} email={contacto.email} horario={contacto.horario} clase="lg:hidden" />
                </div>
            </div>
        </div>
    </section>
</div>
