---
/**
 * /cronograma: las fechas de examen, administradas en el panel.
 *
 * Parte de `PaginaOesi`, que pone el marco (cabecera, índice, «Continúa» y
 * las anclas). Los estilos de estas páginas están allí, en su <style>.
 */
import type { Oesi } from '../../../lib/api';
import Boton from '../../Boton.astro';
import Flecha from '../../Flecha.astro';
import Icono from '../../Icono.astro';
import FondoSeccion from '../../FondoSeccion.astro';
import PasosInscripcion from '../PasosInscripcion.astro';
import FechasCronograma from '../FechasCronograma.astro';
import { faWhatsapp } from '@fortawesome/free-brands-svg-icons';
import { faEnvelope, faTriangleExclamation } from '@fortawesome/free-solid-svg-icons';

interface Props {
    oesi: Oesi;
}

const { oesi } = Astro.props;
const { contacto } = oesi;
const wa = contacto.whatsapp;
---

{/* ══ Cronograma ══ */}
<div id="cronograma" class="panel-oesi">
    {/* `overflow-clip` y no `overflow-hidden`: recorta el fondo igual,
        pero no crea un contenedor de desplazamiento, que es lo que
        anulaba el `sticky` de la tarjeta lateral. */}
    <section class="relative isolate overflow-clip bg-fondo-suave py-12">
        <FondoSeccion />
        <div class="mx-auto max-w-6xl px-6">
            <PasosInscripcion actuales={['fecha']} />

            {/* El aviso de la oficina sobre las fechas, delante de ellas. */}
            {oesi.cronograma.aviso && (
                <p class="mx-auto mt-8 flex max-w-3xl gap-3 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm leading-relaxed text-amber-950" role="note">
                    <Icono icono={faTriangleExclamation} clase="mt-0.5 h-4 w-4 flex-none" />
                    <span>{oesi.cronograma.aviso}</span>
                </p>
            )}

            {/*
             * Las fechas, administradas en el panel, y a su lado lo que se
             * hace después: pagar, o preguntar si hay dudas. La tarjeta lateral
             * acompaña al bajar (`sticky`).
             */}
            <div class="grid items-start gap-8 lg:grid-cols-12">
                {/* `min-w-0`: sin él, una palabra larga del cartel estira la
                    columna de la rejilla más allá de la pantalla. */}
                <div class="min-w-0 lg:col-span-8">
                    <FechasCronograma
                        fechas={oesi.cronograma.fechas}
                        ordenIdiomas={oesi.idiomas.map((i) => i.nombre)}
                        intro={oesi.cronograma.intro}
                        requisitos={oesi.examen.requisitos}
                        institucion={oesi.institucion}
                        whatsapp={wa}
                        email={contacto.email}
                    />
                </div>
                <aside
                    aria-labelledby="t-inscribete-fecha"
                    class="relative mt-10 overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm lg:sticky lg:top-40 lg:col-span-4"
                >
                    <div aria-hidden="true" class="marca-degradado h-1 w-full"></div>

                    <div class="p-6 sm:p-7">
                        <p class="text-[0.7rem] font-semibold uppercase tracking-wider text-slate-500">Cuando tengas tu fecha</p>
                        <h2 id="t-inscribete-fecha" class="mt-1 font-serif text-xl font-bold text-unmsm-azul">
                            Paga el derecho de examen
                        </h2>
                        <p class="mt-2 text-sm leading-relaxed text-slate-600">
                            Con tu fecha elegida, paga en San Market el concepto que te corresponde y luego envía el formulario de la convocatoria.
                        </p>


                        <div class="mt-6">
                            <Boton href="/inscripcion#paso-pago" variante="azul" ancho>
                                Siguiente: pagar
                                <Flecha clase="h-4 w-4" />
                            </Boton>
                        </div>

                        <div class="mt-7 border-t border-slate-100 pt-5">
                            <p class="text-sm font-semibold text-slate-700">¿Dudas con las fechas?</p>
                            <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm">
                                {wa && (
                                    <a href={wa.enlace} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 font-semibold text-unmsm-azul hover:underline">
                                        <Icono icono={faWhatsapp} clase="h-4 w-4" />
                                        {wa.visible}
                                    </a>
                                )}
                                {contacto.email && (
                                    <a href={`mailto:${contacto.email}`} class="inline-flex items-center gap-1.5 font-semibold text-unmsm-azul hover:underline">
                                        <Icono icono={faEnvelope} clase="h-4 w-4" />
                                        Escribir al correo
                                    </a>
                                )}
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </section>
</div>
