# Variables que consume docker-compose.yml.
#
# Compose sustituye ${VARIABLE} leyendo el fichero .env que esté JUNTO al
# docker-compose.yml, es decir en la raíz del repositorio. NO lee el .env de
# oesiletras/, que es el de Laravel. Son dos ficheros distintos con dos
# lectores distintos, y confundirlos deja MySQL con las contraseñas de
# plantilla mientras la aplicación intenta entrar con las que tú pusiste.
#
#   cp .env.example .env
#
# Las tres contraseñas de aquí deben coincidir con las de oesiletras/.env:
#   DB_DATABASE  ↔  DB_DATABASE
#   DB_USERNAME  ↔  DB_USERNAME
#   DB_PASSWORD  ↔  DB_PASSWORD

# Base de datos que crea el contenedor de MySQL al arrancar por primera vez.
DB_DATABASE=oesiletras
DB_USERNAME=oesi_user

# Cámbialas. Las de abajo son de plantilla y no valen para nada expuesto.
DB_PASSWORD=cambia_esta_password
DB_ROOT_PASSWORD=cambia_esta_password_de_root

# Puerto por el que se llega a MySQL desde el host (dentro de la red de Docker
# siempre es el 3306). 3308 y no 3307, que es el del sitio del CERSEU: así
# pueden correr los dos en la misma máquina.
DB_PORT=3308

# Usuario con el que corre el contenedor de PHP. En Linux debe coincidir con
# el duenio de los ficheros del repositorio o la aplicacion no podra escribir
# en storage/:  id -u  e  id -g  te los dicen. En Windows y macOS da igual.
UID=1000
GID=1000

# Dominios que atiende nginx, separados por espacios. Se inyectan en la
# plantilla de configuracion, asi que levantar el sistema en otro dominio no
# exige tocar ningun .conf.
#
# Sin `www.` a proposito, y por dos razones que conviene no descubrir en
# produccion: no hay registro DNS para ese nombre, y el certificado de la
# universidad es un comodin `*.unmsm.edu.pe`, que cubre
# suficiencialetras.unmsm.edu.pe pero NO www.suficiencialetras.unmsm.edu.pe —un comodin
# vale para un solo nivel—. Anadirlo no impide que nginx arranque: lo que hace
# es que quien entre por ese nombre reciba una advertencia de seguridad del
# navegador, que es peor que un nombre que no responde.
NGINX_SERVER_NAMES=suficiencialetras.unmsm.edu.pe

# Secreto compartido entre Laravel y el servicio que reconstruye el sitio.
# Un endpoint que lanza un build sin autenticar es una forma comoda de tumbar
# el servidor desde fuera. Cambialo. (scripts/preparar-entorno.sh los genera.)
OESI_BUILD_TOKEN=cambia-este-token

# Secreto de la vista previa de borradores: el mismo en oesiletras/.env. Vacío
# la desactiva, que es lo correcto mientras nadie la necesite.
OESI_VISTA_PREVIA_TOKEN=

# Dominio publico del sitio. De aqui salen el sitemap y las URL canonicas, que
# Astro necesita al construir. No lleva barra final.
OESI_SITE=https://suficiencialetras.unmsm.edu.pe

# Puertos del host. En producción la OESI tiene su propia VM: 80 y 443. Solo
# en una máquina de desarrollo donde corra también el CERSEU —que usa los
# mismos— hay que cambiar WEB_PORT y WEB_SSL_PORT (p. ej. 8090 y 8453). Los
# demás ya vienen apartados de los del CERSEU.
WEB_PORT=80
WEB_SSL_PORT=443
VITE_PORT=5174
ASTRO_PORT=4331
BUILD_PORT=4332

# Correo del administrador que crea el seeder. Por defecto, el de la oficina:
# es a donde llega el enlace de «olvidé mi contraseña».
# ADMIN_EMAIL=examensuficiencia.flch@unmsm.edu.pe
