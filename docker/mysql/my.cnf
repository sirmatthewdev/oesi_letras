[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
skip-character-set-client-handshake

# Hora de Lima, para que created_at y las fechas del cronograma no salgan
# desplazadas respecto a lo que ve quien administra.
default-time-zone = '-05:00'

# El sitio guarda contenido HTML largo en columnas de texto (secciones de
# /tramites, cuerpos de anuncios) y los volcados de mysqldump los restaura en
# una sola sentencia.
max_allowed_packet = 64M

# El servidor comparte una VM de 1 vCPU y 3,6 GB con el resto del stack. Con
# performance_schema activo MySQL reserva ~400 MB que acababan en swap y
# volvían lenta toda la máquina; la base pesa pocos MB, así que no hace falta.
performance_schema = OFF
innodb_buffer_pool_size = 64M
max_connections = 30

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
